# Markdown Notes web app environment (local development).
# Production hub settings live in the systemd unit and ~/.config/markdown-notes/backend.env;
# see docs/operations.md for the full variable reference. Do not commit .env files.

# Runtime data directory. Defaults to ./data.
# MARKDOWN_NOTES_DATA_DIR=./data

# Model backend (server-only; must be a loopback URL).
# LLAMACPP_BASE_URL=http://127.0.0.1:8089/v1
# LLAMACPP_MODEL=laguna-xs-2.1-q4_k_m
# LLAMACPP_API_KEY=

# Knowledge-graph enrichment loop.
# GRAPH_ENRICH_ENABLED=1
# GRAPH_ENRICH_INTERVAL_MINUTES=60
# GRAPH_ENRICH_LLM=1
